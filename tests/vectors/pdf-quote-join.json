{
 "slug": "pdf-quote-join",
 "module": "pdf-quote-join/src/join",
 "function": "joinWithPaths",
 "note": "Simple wiki page links. Each paths value is a resolved local file or null. The Undo case also has undoExpected for the exact original editor text. Real editor Undo is checked in test/e2e.",
 "cases": [
  {
   "name": "01 two page quotes keep both source links",
   "args": [
    "> [!pdf] [[A.pdf#page=1|p1]]\n> First.\n\n> [!pdf] [[A.pdf#page=2|p2]]\n> Second.",
    {
     "A.pdf": "A.pdf",
     "B.pdf": "B.pdf",
     "folder/A.pdf": "A.pdf"
    }
   ],
   "expected": {
    "ok": true,
    "text": "> [!pdf] [[A.pdf#page=1|p1]] [[A.pdf#page=2|p2]]\n> First.\n>\n> Second.",
    "links": [
     "[[A.pdf#page=1|p1]]",
     "[[A.pdf#page=2|p2]]"
    ],
    "pdf": "A.pdf"
   }
  },
  {
   "name": "02 duplicate link stays once",
   "args": [
    "> [!pdf] [[A.pdf#page=1|p1]]\n> First.\n\n> [!pdf] [[A.pdf#page=1|p1]]\n> Second.",
